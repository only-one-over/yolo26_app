# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Model weights (too large for Git)
*.pt
*.pth
*.onnx
*.engine
*.torchscript
*.tflite
*.mlmodel

# Training outputs
runs/*
wandb/
# 保留目录骨架(.gitkeep 例外)
!runs/.gitkeep

# Datasets
datasets/*
# 保留目录骨架(.gitkeep 例外)
!datasets/.gitkeep

# Workspace directories (auto-created, contains user data/models)
system_model/*
my_project/*
# 保留目录骨架(.gitkeep 例外)
!system_model/.gitkeep
!my_project/.gitkeep
!my_project/default/
my_project/default/*
!my_project/default/.gitkeep

# Application runtime data
.yolo26_app/

# OS files
.DS_Store
Thumbs.db

# Process files (design references, AI specs, architecture docs)
.trae/
.design/
CODE_WIKI.md

# Logs
*.log

# Graphify temp files
.graphify_*.json
_graphify_*.py
graphify-out/

